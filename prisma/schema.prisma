// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(CANDIDATE)
  createdAt DateTime   @default(now())
  recruiter Recruiter?
  candidate Candidate?
}

enum Role {
  CANDIDATE
  RECRUITER
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Recruiter {
  id              String             @id @default(uuid())
  user            User               @relation(fields: [userId], references: [id])
  userId          String             @unique
  jobTitle        String?
  phoneNumber     String?
  companyName     String?
  companyWebsite  String?
  companyLinkedIn String?
  industry        String?
  companySize     CompanySize?
  hiringForRoles  Json?
  isVerified      verificationStatus @default(PENDING)
  failedReasons   Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum verificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Candidate {
  id                String           @id @default(uuid())
  user              User             @relation(fields: [userId], references: [id])
  userId            String           @unique
  phoneNumber       String?
  status            CandidateStatus?
  institution       String?
  graduationYear    String?
  degree            String?
  primarySkills     Json?
  secondarySkills   Json?
  experienceLevel   ExperienceLevel?
  preferredRoles    Json?
  githubUrl         String?
  linkedinUrl       String?
  portfolioUrl      String?
  jobTypePreference JobType?
  openToWork        Boolean          @default(true)
  availability      Availability?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum CandidateStatus {
  NONE
  STUDENT
  GRADUATE
  WORKING_PROFESSIONAL
}

enum ExperienceLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum JobType {
  NONE
  INTERNSHIP
  FULL_TIME
  BOTH
}

enum Availability {
  NONE
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  LATER
}
