generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  role       UserRole   @default(CANDIDATE)
  createdAt  DateTime   @default(now())
  password   String
  profilePic String?
  candidate  Candidate?
  recruiter  Recruiter?
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Recruiter {
  id              String             @id @default(uuid())
  userId          String             @unique
  jobTitle        String?
  phoneNumber     String?
  companyName     String?
  companyWebsite  String?
  companyLinkedIn String?
  industry        String?
  companySize     CompanySize?
  hiringForRoles  Role[]             @relation("RecruiterHiringRoles")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  failedReasons   Json?
  isVerified      verificationStatus @default(PENDING)
  interviews      Interview[]
  postJob         PostJob[]
  user            User               @relation(fields: [userId], references: [id])
}

model Candidate {
  id                String           @id @default(uuid())
  userId            String           @unique
  phoneNumber       String?
  status            CandidateStatus?
  institution       String?
  graduationYear    String?
  degree            String?
  primarySkills     Skill[]          @relation("CandidatePrimarySkills")
  secondarySkills   Skill[]          @relation("CandidateSecondarySkills")
  experienceLevel   ExperienceLevel?
  preferredRoles    Role[]           @relation("CandidatePreferredRoles")
  githubUrl         String?
  linkedinUrl       String?
  portfolioUrl      String?
  jobTypePreference JobType?
  openToWork        Boolean          @default(true)
  availability      Availability?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isVerified        Boolean          @default(false)
  applications      Application[]
  user              User             @relation(fields: [userId], references: [id])
  resumes           Resume[]
}

model Resume {
  id             String        @id @default(uuid())
  candidateId    String
  resumeUrl      String
  resumeMimeType String
  resumeName     String
  resumeSize     Int
  resumeScore    Int           @default(0)
  isActive       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  applications   Application[]
  candidate      Candidate     @relation(fields: [candidateId], references: [id])

  @@index([createdAt, id])
}

model PostJob {
  id                 String             @id @default(uuid())
  recruiterId        String
  title              String
  description        String
  location           String
  minSalary          Int
  maxSalary          Int
  department         Department
  jobType            JobType
  experienceRequired ExperienceRequired
  benifits           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  requirements       Skill[]            @relation("JobRequiredSkills")
  optional           Skill[]            @relation("JobOptionalSkills")
  status             JobStatus          @default(ACTIVE)
  applications       Application[]
  recruiter          Recruiter          @relation(fields: [recruiterId], references: [id])

  @@index([createdAt, id])
}

model Skill {
  id                      String     @id @default(uuid())
  name                    String     @unique
  aliases                 String[]   @default([])
  category                String[]
  popularity              Int        @default(0)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  requiredForJobId        String?
  optionalForJobId        String?
  primaryForCandidateId   String?
  embedding               Float[]
  secondaryForCandidateId String?
  requiredForJob          PostJob?   @relation("JobRequiredSkills", fields: [requiredForJobId], references: [id])
  optionalForJob          PostJob?   @relation("JobOptionalSkills", fields: [optionalForJobId], references: [id])
  primaryForCandidate     Candidate? @relation("CandidatePrimarySkills", fields: [primaryForCandidateId], references: [id])
  secondaryForCandidate   Candidate? @relation("CandidateSecondarySkills", fields: [secondaryForCandidateId], references: [id])
}

model Role {
  id                     String     @id @default(uuid())
  name                   String     @unique
  aliases                String[]   @default([])
  category               String[]
  popularity             Int        @default(0)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  embedding              Float[]
  jobId                  String?
  recruiterId            String?
  preferredByCandidateId String?
  recruiter              Recruiter? @relation("RecruiterHiringRoles", fields: [recruiterId], references: [id])
  preferredByCandidate   Candidate? @relation("CandidatePreferredRoles", fields: [preferredByCandidateId], references: [id])
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  jobId       String
  status      ApplicationStatus @default(PENDING)
  score       Int               @default(0)
  createdAt   DateTime          @default(now())
  resumeId    String
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  job         PostJob           @relation(fields: [jobId], references: [id])
  resume      Resume            @relation(fields: [resumeId], references: [id])
  interview   Interview?

  @@unique([jobId, candidateId])
  @@index([createdAt, id])
}

model Interview {
  id            String          @id @default(uuid())
  applicationId String          @unique
  recruiterId   String
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  duration      Int
  location      String?
  meetingLink   String?
  notes         String?
  phno          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  startAt       DateTime
  application   Application     @relation(fields: [applicationId], references: [id])
  recruiter     Recruiter       @relation(fields: [recruiterId], references: [id])

  @@index([createdAt, id])
}

enum UserRole {
  CANDIDATE
  RECRUITER
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum verificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CandidateStatus {
  STUDENT
  GRADUATE
  WORKING_PROFESSIONAL
  NONE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NONE
}

enum JobType {
  INTERNSHIP
  BOTH
  FULL_TIME
  NONE
}

enum Availability {
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  LATER
  NONE
}

enum JobStatus {
  ACTIVE
  CLOSED
}

enum Department {
  ENGINEERING
  DESIGN
  MARKETING
  SALES
  SUPPORT
  HR
  FINANCE
  OPERATIONS
  NONE
}

enum ExperienceRequired {
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR_LEVEL
  LEAD
  EXECUTIVE
  NONE
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WAITLIST
  SCHEDULED
}

enum InterviewType {
  ONLINE
  IN_PERSON
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}
