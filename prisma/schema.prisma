// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(CANDIDATE)
  createdAt DateTime   @default(now())
  recruiter Recruiter?
  candidate Candidate?
}

enum Role {
  CANDIDATE
  RECRUITER
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Recruiter {
  id              String             @id @default(uuid())
  user            User               @relation(fields: [userId], references: [id])
  userId          String             @unique
  jobTitle        String?
  phoneNumber     String?
  companyName     String?
  companyWebsite  String?
  companyLinkedIn String?
  industry        String?
  companySize     CompanySize?
  hiringForRoles  Json?
  isVerified      verificationStatus @default(PENDING)
  failedReasons   Json?
  postJob         PostJob[]
  interviews      Interview[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum verificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Candidate {
  id                String           @id @default(uuid())
  user              User             @relation(fields: [userId], references: [id])
  userId            String           @unique
  phoneNumber       String?
  status            CandidateStatus?
  institution       String?
  graduationYear    String?
  degree            String?
  primarySkills     Json?
  secondarySkills   Json?
  experienceLevel   ExperienceLevel?
  preferredRoles    Json?
  githubUrl         String?
  linkedinUrl       String?
  portfolioUrl      String?
  jobTypePreference JobType?
  openToWork        Boolean          @default(true)
  isVerified        Boolean          @default(false)
  availability      Availability?
  applications      Application[]
  resumes           Resume[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Resume {
  id             String    @id @default(uuid())
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  candidateId    String
  resumeUrl      String
  resumeMimeType String
  resumeName     String
  resumeSize     Int
  isActive       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum CandidateStatus {
  NONE
  STUDENT
  GRADUATE
  WORKING_PROFESSIONAL
}

enum ExperienceLevel {
  NONE
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum JobType {
  NONE
  INTERNSHIP
  BOTH
  FULL_TIME
}

enum Availability {
  NONE
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  THREE_TO_SIX_MONTHS
  LATER
}

model PostJob {
  id                 String             @id @default(uuid())
  recruiter          Recruiter          @relation(fields: [recruiterId], references: [id])
  recruiterId        String
  title              String
  description        String
  location           String
  minSalary          Int
  maxSalary          Int
  department         Department
  jobType            JobType
  experienceRequired ExperienceRequired
  requirements       Json
  optional           Json?
  benifits           Json?
  applications       Application[]
  status             JobStatus          @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

enum JobStatus {
  ACTIVE
  CLOSED
}

enum Department {
  NONE
  ENGINEERING
  DESIGN
  MARKETING
  SALES
  SUPPORT
  HR
  FINANCE
  OPERATIONS
}

enum ExperienceRequired {
  NONE
  ENTRY_LEVEL
  MID_LEVEL
  SENIOR_LEVEL
  LEAD
  EXECUTIVE
}

model Application {
  id          String            @id @default(uuid())
  candidate   Candidate         @relation(fields: [candidateId], references: [id])
  candidateId String
  job         PostJob           @relation(fields: [jobId], references: [id])
  jobId       String
  status      ApplicationStatus @default(PENDING)
  score       Int               @default(0)
  createdAt   DateTime          @default(now())
  interview   Interview?

  @@unique([jobId, candidateId])
}

enum ApplicationStatus {
  PENDING
  WAITLIST
  ACCEPTED
  SCHEDULED
  REJECTED
}

model Interview {
  id            String          @id @default(uuid())
  application   Application     @relation(fields: [applicationId], references: [id])
  applicationId String          @unique
  recruiter     Recruiter       @relation(fields: [recruiterId], references: [id])
  recruiterId   String
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  startAt       DateTime
  duration      Int
  location      String?
  meetingLink   String?
  notes         String?
  phno          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum InterviewType {
  ONLINE
  IN_PERSON
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}
